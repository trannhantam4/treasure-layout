rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get the role of the currently authenticated user.
    function getUserRole() {
      if (request.auth == null) {
        return 'visitor';
      }
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper function to check if the user has one of the specified roles.
    function isOneOfRoles(roles) {
      return getUserRole() in roles;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isOneOfRoles(['admin', 'manager']);

      // Users can create their own doc with role forced to 'visitor'
      allow create: if request.auth.uid == userId
                    && request.resource.data.role == 'visitor'
                    && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'role'])
                    && request.resource.data.uid == request.auth.uid;

      // Self-update: cannot change own role. Admin: full access. Manager: cannot promote to admin/manager.
      allow update: if (request.auth.uid == userId && request.resource.data.role == resource.data.role)
                    || isOneOfRoles(['admin'])
                    || (
                         isOneOfRoles(['manager']) &&
                         resource.data.role != 'admin' && resource.data.role != 'manager' &&
                         request.resource.data.role != 'admin' && request.resource.data.role != 'manager'
                       );

      allow delete: if isOneOfRoles(['admin']);
    }

    // Rules for the 'event' collection
    match /event/{eventId} {
      // READ: Authenticated users can read event data.
      allow read: if true;

      // CREATE & DELETE: Only admins and managers can create or delete events.
      allow create, delete: if isOneOfRoles(['admin', 'manager']);

      // UPDATE: Admins/managers have full update access.
      // Regular authenticated users can ONLY add/remove their own UID to registeredUsers.
      // registeredCount is NOT user-writable — it's handled via FieldValue.increment which
      // is validated as part of the atomic operation alongside registeredUsers.
      allow update: if isOneOfRoles(['admin', 'manager'])
                    || (
                         request.auth != null &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredUsers', 'registeredCount']) &&
                         (
                           // Registering: adding own UID only
                           (
                             request.resource.data.registeredUsers.toSet() == resource.data.registeredUsers.toSet().union([request.auth.uid].toSet()) &&
                             request.resource.data.registeredCount == resource.data.registeredCount + 1
                           ) ||
                           // Un-registering: removing own UID only
                           (
                             request.resource.data.registeredUsers.toSet() == resource.data.registeredUsers.toSet().difference([request.auth.uid].toSet()) &&
                             request.resource.data.registeredCount == resource.data.registeredCount - 1
                           )
                         )
                       );
    }

    // Rules for the 'brands' collection (global brand library)
    match /brands/{brandDocId} {
      allow read: if true;
      allow create, update, delete: if isOneOfRoles(['admin', 'manager']);
    }

    // Rules for the 'assignments' collection (brand-event join table)
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if isOneOfRoles(['admin', 'manager']);
    }

    // Rules for site settings (e.g. homepage sliders)
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isOneOfRoles(['admin', 'manager']);
    }

    // Rules for the 'metadata' collection (auto-increment counters)
    match /metadata/{docId} {
      allow read: if true;

      // Only userCounter can be created/incremented by regular users (during onboarding).
      // All other counters require admin/manager role.
      allow create: if request.auth != null &&
                    docId == 'userCounter' &&
                    request.resource.data.count == 1;

      allow update: if isOneOfRoles(['admin', 'manager']) ||
                    (request.auth != null &&
                     docId == 'userCounter' &&
                     request.resource.data.count == resource.data.count + 1);
    }

    // Rules for the 'stamps' collection (user treasure hunt stamp tickets)
    match /stamps/{stampId} {
      allow read: if request.auth != null &&
                  (resource.data.userId == request.auth.uid ||
                   isOneOfRoles(['admin', 'manager']));

      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    stampId == request.resource.data.eventId + '-' + request.auth.uid;

      // Users can update their own stamps: 'slots' for stamping, and 'claimed', 'claimedAt', 'claimedBy' for prize redemption.
      allow update: if request.auth != null &&
                    (
                      (resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots', 'claimed', 'claimedAt', 'claimedBy']))
                      || isOneOfRoles(['admin', 'manager'])
                    );

      allow delete: if isOneOfRoles(['admin']);
    }

    // Rules for the 'logs' collection (change audit logs)
    match /logs/{logId} {
      allow read: if isOneOfRoles(['admin', 'manager']);
      allow create: if isOneOfRoles(['admin', 'manager']);
    }
  }
}