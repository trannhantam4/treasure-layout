# Firebase client configuration (safe to commit - these are non-secret public identifiers)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ImgBB API Key — required for image uploads
# ⚠️ This key is exposed in the browser bundle (VITE_ prefix).
# For production, migrate to the Cloud Function proxy in functions/index.js:
#   1. npx -y firebase-tools@latest functions:secrets:set IMGBB_API_KEY
#   2. npx -y firebase-tools@latest deploy --only functions
#   3. Swap uploadImageToImgBB in src/Event.js to the httpsCallable version
VITE_IMGBB_API_KEY=
